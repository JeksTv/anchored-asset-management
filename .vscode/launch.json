{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run AnchorEd locally",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "C:/Users/LT322/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node.exe",
      "program": "${workspaceFolder}/node_modules/vinext/dist/cli.js",
      "args": ["dev", "--hostname", "127.0.0.1", "--port", "3000"],
      "cwd": "${workspaceFolder}",
      "env": {
        "APP_ORIGIN": "http://localhost:3000",
        "DATA_DIR": "${workspaceFolder}/data",
        "NODE_ENV": "development"
      },
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart",
      "skipFiles": ["<node_internals>/**"],
      "autoAttachChildProcesses": true
    }
  ]
}
